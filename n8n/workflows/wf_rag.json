      "parameters": {
        "jsCode": "// Caller получает краткую статистику. Коллекция отражает активный бэкенд (тумблер rag_backend).\nconst backend =\n  ($('Get RAG Backend').first().json.provider || 'local').toString().toLowerCase() === 'develonica'\n    ? 'develonica'\n    : 'local';\nconst collection = backend === 'develonica' ? 'arch-docs-rag' : 'docs_chunks';\nconst trigger = $('When Executed by Another Workflow').all();\nreturn [\n  {\n    json: {\n      upserted: trigger.length,\n      status: 'ok',\n      backend,\n      collection,\n    },\n  },\n];"
