    {
      "parameters": {
        "jsCode": "// Идемпотентность повторного прогона (возобновление/переаплоад того же document_id): нативный\n// insert в Qdrant генерит новые point id на каждый прогон → дубли. Перед upsert сносим прежние\n// точки документа по metadata.document_id (native loader кладёт кастомные поля под metadata.*).\n// Backend-aware: коллекция и адрес зависят от тумблера config(key=rag_backend).\n//   local      → http://qdrant:6333 / docs_chunks  (открытый, без auth)\n//   develonica → rag-test Qdrant / arch-docs-rag    (url/api-key из config rag_backend.base_url/api_key,\n//                                                     в обход $env; без ключа дедуп пропускаем)\n// Первый прогон: точек нет → no-op. document_id уникален на загрузку → чужие доки не затронуты.\nconst items = $input.all();\nconst backend =\n  (((items[0] && items[0].json && items[0].json._backend) || 'local').toString().toLowerCase() === 'develonica')\n    ? 'develonica'\n    : 'local';\nconst _docId =\n  (items[0] && items[0].json && items[0].json.payload && items[0].json.payload.document_id) || '';\n\nif (_docId) {\n  let url, headers;\n  if (backend === 'develonica') {\n    const _u = ((items[0] && items[0].json && items[0].json._rag_qdrant_url) || '').toString().trim();\n    const base = String(_u || 'https://rag-test.develonica.group').replace(/\\/+$/, '');\n    const key = ((items[0] && items[0].json && items[0].json._rag_qdrant_key) || '').toString().trim();\n    url = base + '/collections/arch-docs-rag/points/delete?wait=true';\n    // Без ключа удаление вернёт 401 → дубли. Пропускаем дедуп, чтобы не сыпать ошибками.\n    headers = key ? { 'api-key': key } : null;\n  } else {\n    url = 'http://qdrant:6333/collections/docs_chunks/points/delete?wait=true';\n    headers = {};\n  }\n  if (headers) {\n    try {\n      await this.helpers.httpRequest({\n        method: 'POST',\n        url,\n        headers,\n        json: true,\n        timeout: 20000,\n        body: { filter: { must: [{ key: 'metadata.document_id', match: { value: _docId } }] } },\n      });\n    } catch (_) {}\n  }\n}\nreturn items;"
      },
