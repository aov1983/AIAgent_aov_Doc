    {
      "parameters": {
        "jsCode": "// Универсальный sub-workflow поиска по Qdrant.\n// Input items: { query: str, topK?: int, threshold?: float,\n//                excludeDocumentId?: str, includeDocumentId?: str, includeDocumentIds?: str[], extra?: any }\n// Output items: один на каждый input item, в том же порядке:\n//   { _idx: int, query: str, hits: [ { score, payload: {...metadata, content} } ], extra }\n// hits отсортированы по убыванию score, отфильтрованы по threshold + (include|exclude).\n// includeDocumentIds (набор, для сводки по проекту) > includeDocumentId > excludeDocumentId.\n\nconst triggerItems = $('When Executed by Another Workflow').all();\nconst groups = triggerItems.map((t) => ({\n  query: (t.json && t.json.query) || '',\n  topK: (t.json && Number(t.json.topK)) || 5,\n  threshold: t.json && typeof t.json.threshold === 'number' ? t.json.threshold : 0,\n  exclude: (t.json && t.json.excludeDocumentId) || '',\n  include: (t.json && t.json.includeDocumentId) || '',\n  includeIds: Array.isArray(t.json && t.json.includeDocumentIds) ? t.json.includeDocumentIds.filter(Boolean) : null,\n  extra: t.json && t.json.extra,\n  hits: [],\n}));\n\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const doc = j.document || {};\n  const meta = doc.metadata || {};\n  // pairedItem может быть {item:N}, число или undefined; для one-query кейса всё валим в groups[0]\n  let idx = 0;\n  if (groups.length > 1) {\n    if (it.pairedItem && typeof it.pairedItem.item === 'number') idx = it.pairedItem.item;\n    else if (typeof it.pairedItem === 'number') idx = it.pairedItem;\n  }\n  const g = groups[idx];\n  if (!g) continue;\n  if (g.includeIds && g.includeIds.length) {\n    if (!g.includeIds.includes(meta.document_id)) continue;\n  } else if (g.include) {\n    if (meta.document_id !== g.include) continue;\n  } else if (g.exclude && meta.document_id === g.exclude) {\n    continue;\n  }\n  if (typeof j.score === 'number' && j.score < g.threshold) continue;\n  g.hits.push({\n    score: j.score,\n    payload: Object.assign({}, meta, { content: doc.pageContent || meta.content || '' }),\n  });\n}\n\nreturn groups.map((g, i) => ({\n  json: {\n    _idx: i,\n    query: g.query,\n    hits: g.hits.sort((a, b) => (b.score || 0) - (a.score || 0)).slice(0, g.topK),\n    extra: g.extra,\n  },\n}));"
      },
      "id": "rag-format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-64, -304],
      "alwaysOutputData": true
