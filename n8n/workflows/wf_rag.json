    {
      "parameters": {
        "jsCode": "// Читает тумблер бэкенда из Get RAG Backend (config key=rag_backend, значение в колонке provider)\n// и восстанавливает исходные trigger items, добавляя поле _backend. Стоит в ОСНОВНОМ потоке\n// (Trigger → Get RAG Backend → Route Backend → If Search), чтобы Get RAG Backend гарантированно\n// выполнился до If Backend — иначе n8n executionOrder v1 может выполнить If-ветку раньше боковой\n// ноды и упасть с 'Node ... hasn't been executed'. pairedItem проставляем для реассоциации в Format Output.\nconst cfg = ($input.first() && $input.first().json) || {};\nconst backend = (cfg.provider || 'local').toString().toLowerCase() === 'develonica' ? 'develonica' : 'local';\n// Адрес/ключ Qdrant develonica — из этой же config-строки (колонки base_url/api_key), в обход $env\n// (на «чужих» стендах $env заблокирован). Пусто → дефолт URL / пропуск дедупа (см. Dedup Document Points).\nconst _ragUrl = (cfg.base_url || '').toString().trim();\nconst _ragKey = (cfg.api_key || '').toString().trim();\nreturn $('When Executed by Another Workflow').all().map((t, i) => ({\n  json: Object.assign({}, (t && t.json) || {}, { _backend: backend, _rag_qdrant_url: _ragUrl, _rag_qdrant_key: _ragKey }),\n  pairedItem: { item: i },\n}));"
      },
