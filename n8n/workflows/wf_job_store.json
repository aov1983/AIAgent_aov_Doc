    {
      "parameters": {
        "jsCode": "// Возвращаем сохранённые чанки задачи для возобновления: {chunks:[{chunk_index, output}]}.\n// Пустой список = чекпойнтов нет (обработка ещё не доходила или job новый).\nconst rows = $input\n  .all()\n  .map((i) => i.json)\n  .filter((r) => r && r.job_id !== undefined);\nconst chunks = rows.map((r) => ({\n  chunk_index: Number(r.chunk_index),\n  output: r.output != null ? String(r.output) : '',\n}));\nreturn [{ json: { chunks } }];"
      },
      "id": "chunk-list-build",
      "name": "Build Chunk List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        160
      ]
    },
