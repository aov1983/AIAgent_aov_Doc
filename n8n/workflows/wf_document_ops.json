      "id": "resume-auth",
      "name": "[resume] Auth",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-1000, 900]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [
            { "id": "ok", "leftValue": "={{ $json._http_code }}", "rightValue": 200, "operator": { "type": "number", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "resume-if-auth",
      "name": "[resume] If Auth OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-800, 900]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json._body !== undefined ? $json._body : null) }}",
        "options": {
          "responseCode": "={{ $json._http_code }}",
          "responseHeaders": { "entries": [{ "name": "Content-Type", "value": "application/json; charset=utf-8" }] }
        }
      },
      "id": "resume-respond-authfail",
      "name": "[resume] Respond Auth Fail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-600, 1092]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "job_files" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "job_id", "keyValue": "={{ $('Webhook: POST /resume').first().json.body.job_id || '' }}" }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "resume-fetch-file",
      "name": "[resume] Fetch Job File",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-600, 780],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Восстанавливаем загруженный файл из job_files и готовим повторный multipart-POST на /upload\n// с тем же job_id/document_id. Pipeline доделает только недостающие чанки (Merge Chunks читает\n// чекпойнты по job_id). Токен демо-авторизации = username (uploaded_by).\nconst row = $input.first() && $input.first().json;\nif (!row || !row.job_id) {\n  return [{ json: { _found: false } }];\n}\nconst buf = Buffer.from(row.file_b64 || '', 'base64');\nconst bin = await this.helpers.prepareBinaryData(\n  buf,\n  row.filename || 'document',\n  row.mime || 'application/octet-stream',\n);\nreturn [\n  {\n    json: {\n      _found: buf.length > 0,\n      job_id: row.job_id,\n      document_id: row.document_id || '',\n      uploaded_by: row.uploaded_by || '',\n    },\n    binary: { file: bin },\n  },\n];"
      },
      "id": "resume-build",
      "name": "[resume] Build Re-POST",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-380, 780]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [
            { "id": "found", "leftValue": "={{ $json._found }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "resume-if-found",
      "name": "[resume] If Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-160, 780]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/upload",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.uploaded_by }}" }]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "file" },
            { "parameterType": "formData", "name": "job_id", "value": "={{ $json.job_id }}" },
            { "parameterType": "formData", "name": "document_id", "value": "={{ $json.document_id }}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "resume-repost",
      "name": "[resume] Re-POST Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 700]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'resuming', job_id: $('[resume] Build Re-POST').first().json.job_id, document_id: $('[resume] Build Re-POST').first().json.document_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "resume-respond-ok",
      "name": "[resume] Respond Resuming",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [280, 700]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ detail: 'Файл задачи не найден — возобновление невозможно' }) }}",
        "options": {
          "responseCode": 404,
          "responseHeaders": { "entries": [{ "name": "Content-Type", "value": "application/json; charset=utf-8" }] }
        }
      },
      "id": "resume-respond-notfound",
      "name": "[resume] Respond Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [60, 940]
    }
  ],
