    {
      "parameters": {
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "jobs" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "document_id", "condition": "eq", "keyValue": "={{ $('Webhook: POST /documents/delete').first().json.body.document_id || '' }}" }
          ]
        },
        "returnAll": true
      },
      "id": "docdel-get-jobs",
      "name": "[delete] Get Jobs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-600, -120],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Собираем все job_id документа: job_status/job_chunks хранятся ТОЛЬКО по job_id (без\n// document_id), поэтому их нельзя удалить по document_id напрямую. Источники job_id —\n// строка graphs (последний job) и все строки jobs (накапливаются на каждый переаплоад).\n// job_files чистится по document_id ниже, поэтому как источник job_id здесь не нужен.\nconst body = $('Webhook: POST /documents/delete').first().json.body || {};\nconst documentId = body.document_id || '';\nconst ids = new Set();\nfor (const r of $('[delete] Get Graph')\n  .all()\n  .map((i) => i.json)) {\n  if (r && r.job_id) ids.add(String(r.job_id));\n}\nfor (const r of $('[delete] Get Jobs')\n  .all()\n  .map((i) => i.json)) {\n  if (r && r.job_id) ids.add(String(r.job_id));\n}\nreturn [{ json: { document_id: documentId, job_ids: [...ids] } }];"
      },
      "id": "docdel-build-list",
      "name": "[delete] Build Job List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, -120]
    },
    {
      "parameters": {
        "operation": "deleteRows",
        "dataTableId": { "__rl": true, "mode": "name", "value": "graphs" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "document_id", "condition": "eq", "keyValue": "={{ $json.document_id }}" }
          ]
        },
        "options": {}
      },
      "id": "docdel-del-graphs",
      "name": "[delete] Del graphs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
