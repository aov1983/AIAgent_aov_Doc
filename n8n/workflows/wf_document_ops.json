      },
      "id": "docdel-del-files",
      "name": "[delete] Del job_files",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "jsCode": "// Разворачиваем список job_id в отдельные items — чтобы deleteRows по job_status/job_chunks\n// отработал по каждому job_id (нода выполняется по разу на входной item). Пусто → 0 items →\n// эти удаления просто не запускаются.\nconst src = $('[delete] Build Job List').first().json;\nconst ids = src.job_ids || [];\nreturn ids.map((id) => ({ json: { job_id: id, document_id: src.document_id } }));"
      },
      "id": "docdel-expand-jobs",
      "name": "[delete] Expand Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 140]
    },
    {
      "parameters": {
        "operation": "deleteRows",
        "dataTableId": { "__rl": true, "mode": "name", "value": "job_status" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "job_id", "condition": "eq", "keyValue": "={{ $json.job_id }}" }
          ]
        },
        "options": {}
      },
      "id": "docdel-del-status",
      "name": "[delete] Del job_status",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [60, 80]
    },
    {
      "parameters": {
        "operation": "deleteRows",
        "dataTableId": { "__rl": true, "mode": "name", "value": "job_chunks" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "job_id", "condition": "eq", "keyValue": "={{ $json.job_id }}" }
          ]
        },
        "options": {}
      },
      "id": "docdel-del-chunks",
      "name": "[delete] Del job_chunks",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [60, 200]
    },
    {
      "parameters": {
        "jsCode": "// Финал: сносим эмбеддинги документа из Qdrant по metadata.document_id (native @langchain/qdrant\n// кладёт кастомные поля под metadata.*) и формируем сводку. Стоим ПОСЛЕДНЕЙ веткой Build Job List —\n// при executionOrder v1 ветки идут последовательно, поэтому к этому моменту все удаления строк\n// Data Tables уже отработали, и ответ уходит после полной зачистки.\nconst src = $('[delete] Build Job List').first().json;\nconst documentId = src.document_id;\nlet qdrant_deleted = false;\nif (documentId) {\n  try {\n    await this.helpers.httpRequest({\n      method: 'POST',\n      url: 'http://qdrant:6333/collections/docs_chunks/points/delete?wait=true',\n      json: true,\n      timeout: 20000,\n      body: { filter: { must: [{ key: 'metadata.document_id', match: { value: documentId } }] } },\n    });\n    qdrant_deleted = true;\n  } catch (e) {\n    qdrant_deleted = false;\n  }\n}\nreturn [\n  {\n    json: {\n      status: 'deleted',\n      document_id: documentId,\n      jobs_cleared: (src.job_ids || []).length,\n      qdrant_deleted,\n    },\n  },\n];"
      },
      "id": "docdel-finalize",
      "name": "[delete] Finalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, -120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 200 }
      },
      "id": "docdel-respond-ok",
      "name": "[delete] Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [280, -120]
    },
